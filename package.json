{
	"name": "epl.gui",
	"version": "0.0.0",
	"$comment": "version ist ein Platzhalter — die echte Version kommt aus den semantic-release-Tags und wird zur Bauzeit per define eingespielt.",
	"author": "Oliver Braun <oliver.braun@hm.edu>",
	"license": "BSD-3-Clause",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"scripts": {
		"dev": "vite dev --host 127.0.0.1",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"codegen": "graphql-codegen",
		"update-schema": "bash -lc 'set -a && [ -f .env ] && . .env || true; pnpm dlx get-graphql-schema \"${EPL_SERVER:-http://localhost:8080/query}\" > schema.graphql && pnpm codegen'"
	},
	"dependencies": {
		"graphql": "^16.11.0",
		"graphql-request": "^7.2.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@graphql-codegen/cli": "^5.0.4",
		"@graphql-codegen/client-preset": "^4.6.0",
		"@playwright/test": "1.61.1",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.0.0",
		"daisyui": "^5.0.0",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.19.0",
		"svelte-check": "^4.2.2",
		"tailwindcss": "^4.0.0",
		"theme-change": "^2.5.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.62.1",
		"vite": "^6.3.5",
		"vitest": "^4.1.9"
	}
}
